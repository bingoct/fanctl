[Unit]
Description=fanctl - IPMI fan control daemon
Documentation=file:/usr/local/share/doc/fanctl/README.md
# The BMC must be reachable before the first cycle runs.
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/fanctl/config.toml
ConditionPathExists=/etc/fanctl/platform.toml

[Service]
Type=simple
# fanctl logs to stdout; systemd puts that into the journal.
ExecStart=/usr/local/bin/fanctl run
Restart=on-failure
RestartSec=5s
TimeoutStopSec=120s

# ipmitool opens /dev/ipmi0 directly, which needs root (or a udev rule plus
# CAP_SYS_RAWIO). Running as root is the supported configuration.
User=root
Group=root

# Modest sandboxing. Do NOT add PrivateDevices=yes or ProtectKernelTunables
# style options that hide /dev/ipmi*: the daemon would lose the BMC and start
# logging "could not run ipmitool" every cycle.
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes

# SIGTERM lets fanctl write each zone's default_duty_cycle back to its pins
# before exiting. The BMC keeps the last value written, so stopping the unit
# never leaves the fans at the last hot-cycle setting. Pins no zone drives are
# not touched.
#
# TimeoutStopSec must cover the worst case, not one call. When SIGTERM arrives
# the cycle in flight may still be reading sensors (1 x command_timeout_seconds)
# and then writing its batch (1 x command_timeout_seconds), and the shutdown
# path writes every pin again in a single batch (1 x command_timeout_seconds).
# That is 3 x command_timeout_seconds, independent of the pin count: writes are
# batched into one ipmitool exec, so a bigger board does not need a bigger
# timeout. The 10 s default gives 30 s; 120 s leaves plenty of headroom.
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
